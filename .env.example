# Application Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Database Settings
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/seat_reservation
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/testdb
DB_POOL_MIN_SIZE=15
DB_POOL_MAX_SIZE=15
DB_SEMAPHORE_SIZE=15
DB_SEMAPHORE_TIMEOUT=25.0
DB_STATEMENT_CACHE_SIZE=100
DB_LOCK_TIMEOUT=8s
DB_STATEMENT_TIMEOUT=15s
DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT=15s
DB_CONNECT_RETRY_TIMEOUT=60.0

# Security
JWT_SECRET=super-secret-dev-key-change-in-production-32chars
JWT_ALGORITHM=HS256
ADMIN_TOKEN=admin-super-secret-token-change-in-prod

# Domain Limits
DEFAULT_PER_USER_LIMIT=4
